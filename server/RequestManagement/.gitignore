.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs

# קבצי Rider / JetBrains
.idea/
*.sln.iml

# ========================
# NuGet
# ========================
*.nupkg
*.snupkg
# שומרים את התיקייה אבל לא את החבילות שהורדו
**/packages/*
!**/packages/build/
project.lock.json
project.fragment.lock.json
artifacts/

